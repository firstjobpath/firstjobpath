generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  MENTOR
  ADMIN
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OtpPurpose {
  REGISTER
  LOGIN
  RESET_PASSWORD
  PHONE_VERIFY
}

enum OtpChannel {
  EMAIL
  SMS
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum NotificationJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum LiveSessionProvider {
  GOOGLE_MEET
  ZOOM
  OTHER
}

enum PaymentTransactionType {
  CAPTURE
  REFUND
}

enum AiReportType {
  RESUME
  INTERVIEW
  ROADMAP
}

enum CouponDiscountType {
  PERCENT
  FIXED
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  password      String?
  role          Role      @default(STUDENT)
  phone         String?
  googleId      String?   @unique @map("google_id")
  emailVerified Boolean   @default(false) @map("email_verified")
  xp            Int       @default(0)
  level         Int       @default(1)
  streakDays    Int       @default(0) @map("streak_days")
  lastActiveAt  DateTime? @map("last_active_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  coursesMentoring     Course[]             @relation("MentorCourses")
  bookings             Booking[]            @relation("StudentBookings")
  assessments          Assessment[]
  placements           Placement[]
  payments             Payment[]
  refreshTokens        RefreshToken[]
  mentorAvailabilities MentorAvailability[] @relation("MentorSlots")
  liveSessionsHosting  LiveSession[]        @relation("HostSessions")
  userAchievements     UserAchievement[]
  aiReports            AiReport[]
  auditLogs            AuditLog[]
  notificationJobs     NotificationJob[]
  bookingWaitlists     BookingWaitlist[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Course {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  mentorId    String   @map("mentor_id")
  thumbnail   String?
  createdAt   DateTime @default(now()) @map("created_at")

  mentor           User              @relation("MentorCourses", fields: [mentorId], references: [id], onDelete: Cascade)
  bookings         Booking[]
  payments         Payment[]
  bookingWaitlists BookingWaitlist[]

  @@index([mentorId])
  @@map("courses")
}

model MentorAvailability {
  id         String   @id @default(uuid())
  mentorId   String   @map("mentor_id")
  startTime  DateTime @map("start_time")
  endTime    DateTime @map("end_time")
  seatsTotal Int      @default(1) @map("seats_total")
  seatsTaken Int      @default(0) @map("seats_taken")
  createdAt  DateTime @default(now()) @map("created_at")

  mentor    User              @relation("MentorSlots", fields: [mentorId], references: [id], onDelete: Cascade)
  bookings  Booking[]
  waitlists BookingWaitlist[]

  @@index([mentorId, startTime])
  @@map("mentor_availability")
}

model Booking {
  id                   String        @id @default(uuid())
  studentId            String        @map("student_id")
  courseId             String        @map("course_id")
  slotTime             DateTime      @map("slot_time")
  paymentStatus        String        @map("payment_status")
  status               BookingStatus @default(PENDING)
  mentorAvailabilityId String?       @map("mentor_availability_id")
  expiresAt            DateTime?     @map("expires_at")
  waitlistPosition     Int?          @map("waitlist_position")
  rescheduledFromId    String?       @map("rescheduled_from_id")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  student            User                @relation("StudentBookings", fields: [studentId], references: [id], onDelete: Cascade)
  course             Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  mentorAvailability MentorAvailability? @relation(fields: [mentorAvailabilityId], references: [id], onDelete: SetNull)
  payment            Payment?
  liveSessions       LiveSession[]

  @@index([studentId])
  @@index([courseId, slotTime])
  @@index([status])
  @@map("bookings")
}

model BookingWaitlist {
  id                   String   @id @default(uuid())
  studentId            String   @map("student_id")
  courseId             String   @map("course_id")
  mentorAvailabilityId String?  @map("mentor_availability_id")
  slotTime             DateTime @map("slot_time")
  position             Int
  createdAt            DateTime @default(now()) @map("created_at")

  student            User                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course             Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  mentorAvailability MentorAvailability? @relation(fields: [mentorAvailabilityId], references: [id], onDelete: SetNull)

  @@index([courseId, mentorAvailabilityId])
  @@map("booking_waitlist")
}

model Assessment {
  id        String @id @default(uuid())
  studentId String @map("student_id")
  score     Int
  examType  String @map("exam_type")

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("assessments")
}

model Placement {
  id          String @id @default(uuid())
  studentId   String @map("student_id")
  companyName String @map("company_name")
  role        String
  status      String

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("placements")
}

model LeadSubmission {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  message   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@map("lead_submissions")
}

model Coupon {
  id           String             @id @default(uuid())
  code         String             @unique
  discountType CouponDiscountType @map("discount_type")
  value        Decimal            @db.Decimal(10, 2)
  maxUses      Int?               @map("max_uses")
  usedCount    Int                @default(0) @map("used_count")
  expiresAt    DateTime?          @map("expires_at")
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now()) @map("created_at")

  payments Payment[]

  @@index([code, active])
  @@map("coupons")
}

model Payment {
  id                String        @id @default(uuid())
  userId            String        @map("user_id")
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  razorpayOrderId   String?       @unique @map("razorpay_order_id")
  razorpayPaymentId String?       @unique @map("razorpay_payment_id")
  couponId          String?       @map("coupon_id")
  courseId          String?       @map("course_id")
  bookingId         String?       @unique @map("booking_id")
  metadata          Json?
  failureReason     String?       @map("failure_reason")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon       Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  course       Course?              @relation(fields: [courseId], references: [id], onDelete: SetNull)
  booking      Booking?             @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  invoice      Invoice?
  transactions PaymentTransaction[]

  @@index([userId, status])
  @@index([createdAt])
  @@map("payments")
}

model PaymentTransaction {
  id          String                 @id @default(uuid())
  paymentId   String                 @map("payment_id")
  type        PaymentTransactionType
  amount      Decimal                @db.Decimal(12, 2)
  status      String
  externalRef String?                @map("external_ref")
  createdAt   DateTime               @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_transactions")
}

model Invoice {
  id            String   @id @default(uuid())
  paymentId     String   @unique @map("payment_id")
  invoiceNumber String   @unique @map("invoice_number")
  lineItems     Json     @map("line_items")
  pdfUrl        String?  @map("pdf_url")
  createdAt     DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([invoiceNumber])
  @@map("invoices")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model OtpCode {
  id          String     @id @default(uuid())
  destination String
  channel     OtpChannel
  purpose     OtpPurpose
  codeHash    String     @map("code_hash")
  expiresAt   DateTime   @map("expires_at")
  attempts    Int        @default(0)
  consumedAt  DateTime?  @map("consumed_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([destination, purpose, expiresAt])
  @@map("otp_codes")
}

model NotificationJob {
  id           String                @id @default(uuid())
  userId       String?               @map("user_id")
  channel      NotificationChannel
  templateKey  String                @map("template_key")
  payload      Json
  status       NotificationJobStatus @default(PENDING)
  attempts     Int                   @default(0)
  maxAttempts  Int                   @default(5) @map("max_attempts")
  lastError    String?               @map("last_error")
  scheduledFor DateTime              @default(now()) @map("scheduled_for")
  sentAt       DateTime?             @map("sent_at")
  createdAt    DateTime              @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, scheduledFor])
  @@map("notification_jobs")
}

model LiveSession {
  id              String              @id @default(uuid())
  bookingId       String?             @map("booking_id")
  hostId          String              @map("host_id")
  title           String
  provider        LiveSessionProvider
  meetingUrl      String              @map("meeting_url")
  hostJoinUrl     String?             @map("host_join_url")
  startsAt        DateTime            @map("starts_at")
  endsAt          DateTime            @map("ends_at")
  recordingUrl    String?             @map("recording_url")
  attendanceCount Int                 @default(0) @map("attendance_count")
  createdAt       DateTime            @default(now()) @map("created_at")

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  host    User     @relation("HostSessions", fields: [hostId], references: [id], onDelete: Cascade)

  @@index([hostId, startsAt])
  @@map("live_sessions")
}

model Achievement {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String?  @db.Text
  xpReward    Int      @default(0) @map("xp_reward")
  createdAt   DateTime @default(now()) @map("created_at")

  users UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  userId        String   @map("user_id")
  achievementId String   @map("achievement_id")
  unlockedAt    DateTime @default(now()) @map("unlocked_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
  @@map("user_achievements")
}

model AiReport {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  type      AiReportType
  input     Json
  result    Json
  createdAt DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("ai_reports")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  ip         String?
  userAgent  String?  @map("user_agent")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@map("login_attempts")
}
