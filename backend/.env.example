# Cloudinary signed uploads
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# OpenAI (resume / roadmap — falls back to mock if unset)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
